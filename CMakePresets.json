{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "architecture": { "value": "x64", "strategy": "external" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug (Ninja)",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release (Ninja)",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "vs2022",
            "displayName": "Visual Studio 2022 solution (x64)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/vs2022",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "vs2026",
            "displayName": "Visual Studio 2026 solution (x64)",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/vs2026",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        }
    ],
    "buildPresets": [
        { "name": "x64-debug",       "configurePreset": "x64-debug" },
        { "name": "x64-release",     "configurePreset": "x64-release" },
        { "name": "vs2022-debug",    "configurePreset": "vs2022", "configuration": "Debug" },
        { "name": "vs2022-release",  "configurePreset": "vs2022", "configuration": "Release" },
        { "name": "vs2026-debug",    "configurePreset": "vs2026", "configuration": "Debug" },
        { "name": "vs2026-release",  "configurePreset": "vs2026", "configuration": "Release" }
    ],
    "testPresets": [
        { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release", "output": { "outputOnFailure": true } },
        { "name": "vs2022-release", "configurePreset": "vs2022", "configuration": "Release", "output": { "outputOnFailure": true } }
    ]
}
